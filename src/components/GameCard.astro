---
import type { Game } from '../lib/games';
interface Props { game: Game }
const { game } = Astro.props;
const name = game.titleZh || game.title;
const searchText = [
  game.title, game.titleZh, game.originalTitle, game.developer, game.publisher,
  game.originalPlatform, String(game.originalYear ?? ''),
  ...game.platforms, ...game.genres,
].filter(Boolean).join(' ').toLowerCase();
const typeZh = game.type === 'remake' ? '重制' : '复刻';
---

<a class="game-card" href={`/game/${game.id}/`} data-search={searchText} data-type={game.type}
   data-platforms={game.platforms.join('|')} data-genres={game.genres.join('|')}
   data-year={game.releaseYear ?? ''} data-original-year={game.originalYear ?? ''} data-title={name}>
  <div class="art">
    {game.cover
      ? <img class="cover-img" src={game.cover} alt={name} loading="lazy" width="460" height="215" />
      : <span class="fallback" data-initial={game.title.replace(/[^A-Za-z0-9]/g, '').slice(0, 2).toUpperCase() || 'RH'}>{name.slice(0, 2)}</span>}
    {game.upcoming && <span class="pill upcoming">开发中</span>}
    {game.steamAppid && !game.upcoming && <span class="steam-badge">Steam 有售</span>}
  </div>
  <div class="body">
    <h3 class="title">{name}</h3>
    <p class="orig">原作：<i>{game.originalTitle}</i>{game.originalYear ? `（${game.originalYear}）` : ''}</p>
    <div class="meta">
      <span class={`pill ${game.type}`}>{typeZh}</span>
      <span class="year">{game.releaseYear ?? '待定'}</span>
    </div>
    <p class="desc">{game.description}</p>
  </div>
</a>

<style>
  .game-card {
    display: flex; flex-direction: column;
    background: var(--panel); border-radius: 4px; overflow: hidden;
    transition: transform .12s ease, background .12s ease;
  }
  .game-card:hover { background: var(--panel-hover); transform: translateY(-2px); }
  .art {
    height: 132px; position: relative; overflow: hidden;
    background: radial-gradient(ellipse at 30% 20%, #3a6a8f 0%, #1f3a52 70%);
    display: flex; align-items: center; justify-content: center;
  }
  .art img { transition: transform .3s ease; }
  .game-card:hover .art img { transform: scale(1.04); }
  .fallback {
    font-size: 34px; font-weight: 800; color: rgba(255,255,255,.25);
    letter-spacing: 2px; user-select: none;
  }
  .pill { position: static; }
  .art .pill { position: absolute; top: 8px; left: 8px; }
  .steam-badge {
    position: absolute; bottom: 8px; right: 8px;
    background: rgba(23,26,33,.85); color: #66c0f4;
    font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 2px;
  }
  .body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .title { font-size: 15.5px; color: var(--text-bright); font-weight: 600; line-height: 1.3; }
  .orig { font-size: 12px; color: var(--text-dim); }
  .orig i { color: var(--text); font-style: italic; }
  .meta { display: flex; align-items: center; gap: 8px; }
  .year { font-size: 13px; color: var(--accent); font-weight: 600; }
  .desc {
    font-size: 12.5px; line-height: 1.5; color: var(--text-dim);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
</style>
