---
import Layout from '../layouts/Layout.astro';
---

<Layout title="提交游戏 — RemakeHub" description="向 RemakeHub 推荐一款缺失的重制版或高清复刻版游戏。">
  <div class="container submit">
    <h1>提交游戏</h1>
    <p class="intro">发现有重制版/复刻版没被收录？填写你了解的信息，维护者审核后就会上线。带 <b>*</b> 为必填项。</p>

    <form id="form" novalidate>
      <div class="field">
        <label for="title">游戏名称（中文译名或通用叫法） *</label>
        <input id="title" name="title" required maxlength="120" placeholder="例：最终幻想7 重制版" />
      </div>
      <div class="field">
        <label for="originalTitle">原作名称 *</label>
        <input id="originalTitle" name="originalTitle" required maxlength="120" placeholder="例：Final Fantasy VII" />
      </div>
      <div class="row">
        <div class="field">
          <label for="type">类型 *</label>
          <select id="type" name="type" required>
            <option value="remake">重制版 Remake — 从零重建</option>
            <option value="remaster">高清复刻 Remaster — 原作强化</option>
          </select>
        </div>
        <div class="field">
          <label for="releaseYear">发售年份</label>
          <input id="releaseYear" name="releaseYear" type="number" min="1980" max="2030" placeholder="2025" />
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="originalPlatform">原作平台</label>
          <input id="originalPlatform" name="originalPlatform" maxlength="60" placeholder="例：SFC、PS1、街机…" />
        </div>
        <div class="field">
          <label for="originalYear">原作年份</label>
          <input id="originalYear" name="originalYear" type="number" min="1970" max="2026" placeholder="1997" />
        </div>
      </div>
      <div class="field">
        <label for="platforms">现行平台 <span class="hint">（逗号分隔）</span></label>
        <input id="platforms" name="platforms" maxlength="120" placeholder="例：Switch, PS5, PC" />
      </div>
      <div class="field">
        <label for="developer">开发商</label>
        <input id="developer" name="developer" maxlength="80" placeholder="例：Square Enix" />
      </div>
      <div class="field">
        <label for="genres">题材 <span class="hint">（逗号分隔，如 RPG、动作、战棋）</span></label>
        <input id="genres" name="genres" maxlength="80" placeholder="例：RPG, 战棋" />
      </div>
      <div class="field">
        <label for="description">简介 *</label>
        <textarea id="description" name="description" required maxlength="400" rows="3" placeholder="一两句话介绍这款重制/复刻版。"></textarea>
      </div>
      <div class="field">
        <label for="source">来源链接 <span class="hint">（商店页/官方公告，便于核实）</span></label>
        <input id="source" name="source" type="url" placeholder="https://…" />
      </div>

      <div class="status" id="status" hidden></div>

      <button class="btn" type="submit" id="submitBtn">提交审核</button>
      <p class="alt">更习惯 GitHub？<a href="https://github.com/ameng1024/remakehub.org/issues/new?title=%5BSubmission%5D%20%E6%B8%B8%E6%88%8F%E5%90%8D" target="_blank" rel="noopener">直接开 Issue</a> 也行。</p>
    </form>
  </div>
</Layout>

<style>
  .submit { max-width: 640px; padding: 40px 16px 64px; }
  h1 { color: var(--text-bright); font-size: 30px; margin-bottom: 8px; }
  .intro { color: var(--text-dim); font-size: 14.5px; line-height: 1.6; margin-bottom: 28px; }
  .intro b { color: var(--accent); }
  form { display: flex; flex-direction: column; gap: 16px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  label { font-size: 13px; color: var(--text); font-weight: 600; }
  .hint { color: var(--text-dim); font-weight: 400; }
  input, select, textarea {
    background: #223c50; border: 1px solid rgba(0,0,0,.3); border-radius: 3px;
    color: var(--text-bright); font-size: 14px; padding: 10px 12px; outline: 0;
    font-family: inherit; width: 100%;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--accent); }
  input::placeholder, textarea::placeholder { color: #5a7a94; }
  textarea { resize: vertical; }
  .status { padding: 12px 14px; border-radius: 3px; font-size: 14px; line-height: 1.5; }
  .status.ok { background: rgba(164,208,7,.12); border: 1px solid rgba(164,208,7,.4); color: #c3e05c; }
  .status.err { background: rgba(230,60,60,.12); border: 1px solid rgba(230,60,60,.4); color: #ff7b7b; }
  .alt { font-size: 13px; color: var(--text-dim); }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('form') as HTMLFormElement;
  const status = document.getElementById('status')!;
  const btn = document.getElementById('submitBtn') as HTMLButtonElement;

  function show(kind: 'ok' | 'err', msg: string, link?: string) {
    status.className = 'status ' + kind;
    status.innerHTML = msg + (link ? ` <a href="${link}" target="_blank" rel="noopener">点此跟进 →</a>` : '');
    status.hidden = false;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    if (!data.title || !data.originalTitle || !data.description) {
      show('err', '请填写必填项（游戏名称、原作名称、简介）。');
      return;
    }
    btn.disabled = true;
    btn.textContent = '提交中…';
    try {
      const res = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (res.ok) {
        show('ok', '提交成功！已进入审核队列。', json.issueUrl);
        form.reset();
      } else {
        show('err', json.error || '提交失败，请稍后再试。', json.fallbackIssue);
      }
    } catch {
      show('err', '网络错误，请检查网络后重试；也可以用下方 GitHub 链接直接提交。');
    } finally {
      btn.disabled = false;
      btn.textContent = '提交审核';
    }
  });
</script>
