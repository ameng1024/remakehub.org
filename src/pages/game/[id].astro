---
import Layout from '../../layouts/Layout.astro';
import { getGame, games, displayName, storeLinks, relatedVersions } from '../../lib/games';

export function getStaticPaths() {
  return games.map(g => ({ params: { id: g.id } }));
}

const game = getGame(Astro.params.id!)!;
const name = displayName(game);
const typeZh = game.type === 'remake' ? '重制版' : '高清复刻版';
const links = storeLinks(game);
const versions = relatedVersions(game);
const others = games.filter(g => g.id !== game.id && (g.genres.some(x => game.genres.includes(x)) || g.developer === game.developer)).slice(0, 4);
---

<Layout title={`${name} — RemakeHub`} description={game.description}>
  <div class="container detail">
    <a href="/" class="back">← 返回游戏库</a>
    <div class="header">
      <div class="art">
        {game.cover
          ? <img class="cover-img" src={game.cover} alt={name} width="460" height="215" />
          : <span class="fallback">{name.slice(0, 2)}</span>}
      </div>
      <div class="info">
        <div class="badges">
          <span class={`pill ${game.type}`}>{typeZh}</span>
          {game.upcoming && <span class="pill upcoming">开发中</span>}
        </div>
        <h1>{name}</h1>
        <p class="based">原作 <a href={`/?q=${encodeURIComponent(game.originalTitle)}`}>{game.originalTitle}</a>
          {game.originalYear ? `（${game.originalYear} 年，${game.originalPlatform}）` : `（${game.originalPlatform}）`}的{typeZh}</p>
        {game.titleZh && game.titleZh !== game.title && <p class="en-name">{game.title}</p>}
      </div>
    </div>

    {links.length > 0 && (
      <section class="get">
        <h2>🎮 去玩这款游戏</h2>
        <p class="get-hint">官方渠道直达，购买或下载后即可游玩：</p>
        <div class="get-links">
          {links.map(l => (
            <a class={l.primary ? 'store-link primary' : 'store-link'} href={l.url} target="_blank" rel="noopener">
              {l.name} <span>→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {versions.length > 0 && (
      <section class="versions">
        <h2>🔗 同原作的其他版本</h2>
        <p class="v-hint">《{game.originalTitle}》还有这些重制/复刻版本：</p>
        <div class="v-list">
          {versions.map(v => (
            <a class="v-card" href={`/game/${v.id}/`}>
              {v.cover
                ? <img src={v.cover} alt={displayName(v)} loading="lazy" width="92" height="43" />
                : <span class="v-fallback">{displayName(v).slice(0, 2)}</span>}
              <span class="v-info">
                <span class="v-title">{displayName(v)}</span>
                <span class="v-meta">{v.type === 'remake' ? '重制' : '复刻'} · {v.releaseYear ?? '待定'} · {v.platforms.join('、')}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="cols">
      <div class="main">
        <h2>简介</h2>
        <p class="desc">{game.description}</p>

        <h2>原作 vs {typeZh}</h2>
        <div class="compare">
          <div class="col">
            <h4>原作</h4>
            <dl>
              <dt>名称</dt><dd>{game.originalTitle}</dd>
              <dt>平台</dt><dd>{game.originalPlatform}</dd>
              <dt>年份</dt><dd>{game.originalYear ?? '—'}</dd>
            </dl>
          </div>
          <div class="col">
            <h4>{typeZh}</h4>
            <dl>
              <dt>名称</dt><dd>{name}</dd>
              <dt>平台</dt><dd>{game.platforms.join('、')}</dd>
              <dt>年份</dt><dd>{game.releaseYear ?? '待定'}</dd>
            </dl>
          </div>
        </div>
      </div>

      <aside class="side">
        <dl class="facts">
          <div><dt>开发商</dt><dd>{game.developer}</dd></div>
          <div><dt>发行商</dt><dd>{game.publisher}</dd></div>
          <div><dt>发售</dt><dd>{game.releaseYear ?? '待定'}</dd></div>
          <div><dt>题材</dt><dd>{game.genres.join('、')}</dd></div>
          <div><dt>平台</dt><dd>{game.platforms.join('、')}</dd></div>
        </dl>
        <div class="search-links">
          <span class="label">更多情报：</span>
          <a href={`https://www.google.com/search?q=${encodeURIComponent(game.title + ' game')}`} target="_blank" rel="noopener">Google</a>
          <a href={`https://www.youtube.com/results?search_query=${encodeURIComponent(game.title + ' trailer')}`} target="_blank" rel="noopener">YouTube</a>
        </div>
        <p class="wrong">发现信息有误？<a href="/submit">告诉我们</a>，或在 <a href="https://github.com/ameng1024/remakehub.org/issues" target="_blank" rel="noopener">GitHub</a> 提交 Issue。</p>
      </aside>
    </div>

    {others.length > 0 && (
      <section class="related">
        <h2>相关推荐</h2>
        <div class="related-grid">
          {others.map(g => (
            <a class="rel-card" href={`/game/${g.id}/`}>
              <span class={`pill ${g.type}`}>{g.type === 'remake' ? '重制' : '复刻'}</span>
              <span class="t">{displayName(g)}</span>
              <span class="y">{g.releaseYear ?? '待定'}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .detail { padding: 28px 16px 48px; }
  .back { font-size: 13px; color: var(--text-dim); display: inline-block; margin-bottom: 18px; }
  .header { display: flex; gap: 20px; align-items: center; margin-bottom: 24px; }
  .art {
    width: 300px; height: 140px; border-radius: 6px; flex-shrink: 0; overflow: hidden;
    background: radial-gradient(ellipse at 30% 20%, #3a6a8f 0%, #1f3a52 70%);
    display: flex; align-items: center; justify-content: center;
  }
  .fallback { font-size: 34px; font-weight: 800; color: rgba(255,255,255,.25); }
  .info h1 { color: var(--text-bright); font-size: 28px; margin: 6px 0 4px; }
  .based { color: var(--text-dim); font-size: 14px; }
  .en-name { color: var(--text-dim); font-size: 12.5px; margin-top: 2px; }
  .badges { display: flex; gap: 8px; }

  .get {
    background: linear-gradient(135deg, rgba(102,192,244,.08), rgba(102,192,244,.02));
    border: 1px solid rgba(102,192,244,.25); border-radius: 6px;
    padding: 18px 20px; margin-bottom: 28px;
  }
  .get h2 { color: var(--text-bright); font-size: 17px; margin-bottom: 4px; }
  .get-hint { font-size: 13px; color: var(--text-dim); margin-bottom: 12px; }
  .get-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .store-link {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--panel); border: 1px solid rgba(102,192,244,.2);
    color: var(--text); font-size: 14px; font-weight: 500;
    padding: 9px 18px; border-radius: 3px; transition: all .15s;
  }
  .store-link:hover { background: var(--panel-hover); color: #fff; border-color: var(--accent); }
  .store-link.primary {
    background: linear-gradient(to bottom, #3d6c8f 5%, #2a5170 95%);
    color: var(--text-bright); font-weight: 600; border-color: transparent;
  }
  .store-link.primary:hover { filter: brightness(1.2); }
  .store-link span { color: var(--accent); }

  .versions { margin-bottom: 28px; background: var(--panel); border-radius: 6px; padding: 18px 20px; }
  .versions h2 { color: var(--text-bright); font-size: 17px; margin-bottom: 4px; }
  .v-hint { font-size: 13px; color: var(--text-dim); margin-bottom: 12px; }
  .v-list { display: flex; flex-direction: column; gap: 8px; }
  .v-card {
    display: flex; align-items: center; gap: 12px;
    background: rgba(0,0,0,.18); border-radius: 4px; padding: 8px 12px;
    transition: background .12s;
  }
  .v-card:hover { background: rgba(0,0,0,.3); }
  .v-card img { border-radius: 2px; flex-shrink: 0; }
  .v-fallback {
    width: 92px; height: 43px; flex-shrink: 0; border-radius: 2px;
    background: radial-gradient(ellipse at 30% 20%, #3a6a8f 0%, #1f3a52 70%);
    color: rgba(255,255,255,.4); font-weight: 700; font-size: 15px;
    display: flex; align-items: center; justify-content: center;
  }
  .v-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .v-title { color: var(--text-bright); font-size: 14px; font-weight: 600; }
  .v-meta { color: var(--text-dim); font-size: 12px; }

  .cols { display: grid; grid-template-columns: 1fr 300px; gap: 28px; align-items: start; }
  .main h2 { color: var(--text-bright); font-size: 18px; margin: 18px 0 10px; }
  .main h2:first-child { margin-top: 0; }
  .desc { font-size: 15px; line-height: 1.7; color: var(--text); }
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .compare .col { background: var(--panel); border-radius: 4px; padding: 14px; }
  .compare h4 { color: var(--accent); font-size: 13px; letter-spacing: .5px; margin-bottom: 8px; }
  .compare dl { display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; font-size: 13.5px; }
  .compare dt { color: var(--text-dim); }
  .compare dd { color: var(--text-bright); }

  .side { display: flex; flex-direction: column; gap: 16px; }
  .facts { background: var(--panel); border-radius: 4px; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .facts div { display: grid; grid-template-columns: 60px 1fr; gap: 8px; font-size: 13.5px; }
  .facts dt { color: var(--text-dim); }
  .facts dd { color: var(--text-bright); }
  .search-links { background: var(--panel); border-radius: 4px; padding: 14px 16px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; font-size: 13.5px; }
  .search-links .label { color: var(--text-dim); }
  .wrong { font-size: 12.5px; color: var(--text-dim); line-height: 1.5; }

  .related { margin-top: 40px; }
  .related h2 { color: var(--text-bright); font-size: 18px; margin-bottom: 12px; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .rel-card { background: var(--panel); border-radius: 4px; padding: 12px 14px; display: flex; align-items: center; gap: 10px; transition: background .12s; }
  .rel-card:hover { background: var(--panel-hover); }
  .rel-card .t { color: var(--text-bright); font-size: 13.5px; flex: 1; }
  .rel-card .y { color: var(--accent); font-size: 13px; font-weight: 600; }

  @media (max-width: 800px) {
    .cols { grid-template-columns: 1fr; }
    .header { flex-direction: column; align-items: flex-start; }
    .art { width: 100%; max-width: 460px; height: auto; aspect-ratio: 460/215; }
  }
</style>
