---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import { games, allPlatforms, allGenres } from '../lib/games';

const searchPlaceholder = `Search ${games.length} remakes & remasters…`;
---

<Layout title="RemakeHub — Remakes & Remasters of Classic Games">
  <div class="container">
    <section class="hero">
      <h1>Classic games, <span class="accent">reborn</span>.</h1>
      <p>A curated directory of official remakes and remasters — from NES and arcade classics to PS2-era favorites, rebuilt for modern platforms.</p>
    </section>

    <section class="controls" aria-label="Search and filters">
      <div class="search-box">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input id="search" type="search" placeholder={searchPlaceholder} autocomplete="off" />
      </div>
      <div class="filters">
        <select id="type">
          <option value="">Type: All</option>
          <option value="remake">Remake</option>
          <option value="remaster">Remaster</option>
        </select>
        <select id="platform">
          <option value="">Platform: All</option>
          {allPlatforms.map(p => <option value={p}>{p}</option>)}
        </select>
        <select id="genre">
          <option value="">Genre: All</option>
          {allGenres.map(g => <option value={g}>{g}</option>)}
        </select>
        <select id="sort">
          <option value="year-desc">Newest first</option>
          <option value="year-asc">Oldest first</option>
          <option value="title">A → Z</option>
          <option value="original-desc">Original era: newest</option>
          <option value="original-asc">Original era: oldest</option>
        </select>
      </div>
    </section>

    <p class="result-info"><span id="count">{games.length}</span> games</p>

    <div class="grid" id="grid">
      {games.map(g => <GameCard game={g} />)}
    </div>
    <p class="empty" id="empty" hidden>No games match your filters. Try clearing the search.</p>
  </div>

  <style>
    .hero { padding: 48px 0 32px; text-align: center; }
    .hero h1 { font-size: 40px; color: var(--text-bright); letter-spacing: -.5px; }
    .hero .accent { color: var(--accent); }
    .hero p { max-width: 560px; margin: 12px auto 0; color: var(--text-dim); font-size: 16px; line-height: 1.5; }

    .controls { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
    .search-box {
      flex: 1 1 260px; display: flex; align-items: center; gap: 8px;
      background: #223c50; border: 1px solid rgba(0,0,0,.3); border-radius: 3px;
      padding: 0 12px; color: var(--text-dim); min-height: 40px;
    }
    .search-box:focus-within { border-color: var(--accent); }
    .search-box input {
      flex: 1; background: transparent; border: 0; outline: 0;
      color: var(--text-bright); font-size: 14px; min-height: 38px;
    }
    .filters { display: flex; flex-wrap: wrap; gap: 10px; }
    .filters select {
      background: #223c50; color: var(--text); border: 1px solid rgba(0,0,0,.3);
      border-radius: 3px; padding: 0 10px; font-size: 13px; min-height: 40px; cursor: pointer;
    }
    .filters select:hover { color: var(--text-bright); }

    .result-info { color: var(--text-dim); font-size: 13px; margin: 8px 0; }
    .grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
      gap: 14px; padding-bottom: 48px;
    }
    .empty { text-align: center; color: var(--text-dim); padding: 48px 0; }

    @media (max-width: 640px) {
      .hero h1 { font-size: 30px; }
      .filters { width: 100%; }
      .filters select { flex: 1; }
    }
  </style>

  <script>
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.game-card'));
    const index = cards.map(c => ({
      el: c,
      text: (c.dataset.search || '').toLowerCase(),
      type: c.dataset.type || '',
      platform: c.dataset.platforms || '',
      genre: c.dataset.genres || '',
      year: Number(c.dataset.year || 0),
      originalYear: Number(c.dataset.originalYear || 0),
      title: c.dataset.title || '',
    }));

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const search = $('search') as HTMLInputElement;
    const type = $('type') as HTMLSelectElement;
    const platform = $('platform') as HTMLSelectElement;
    const genre = $('genre') as HTMLSelectElement;
    const sort = $('sort') as HTMLSelectElement;
    const count = $('count')!;
    const empty = $('empty')!;

    function apply() {
      const q = search.value.trim().toLowerCase();
      const t = type.value, p = platform.value, g = genre.value, s = sort.value;
      let visible = 0;
      const rows = index.filter(r => {
        if (t && r.type !== t) return false;
        if (p && !r.platform.split('|').includes(p)) return false;
        if (g && !r.genre.split('|').includes(g)) return false;
        if (q && !r.text.includes(q)) return false;
        return true;
      });
      const sorted = rows.slice().sort((a, b) => {
        if (s === 'title') return a.title.localeCompare(b.title);
        if (s === 'year-asc') return (a.year || 9999) - (b.year || 9999);
        if (s === 'original-desc') return b.originalYear - a.originalYear;
        if (s === 'original-asc') return a.originalYear - b.originalYear;
        return (b.year || 0) - (a.year || 0);
      });
      const grid = $('grid')!;
      const frag = document.createDocumentFragment();
      for (const r of sorted) frag.appendChild(r.el);
      grid.appendChild(frag);
      visible = sorted.length;
      count.textContent = String(visible);
      empty.hidden = visible > 0;
    }

    [search, type, platform, genre, sort].forEach(el =>
      el.addEventListener('input', apply)
    );
  </script>
</Layout>
